# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional API key for Groq free-tier high-speed LPU models (Llama 3.3 70B, Llama 3.1 8B, Mixtral, etc.).
# Obtain a free key at https://console.groq.com/keys
GROQ_API_KEY=

# OLLAMA_BASE_URL: Base URL for local or self-hosted Ollama server (defaults to http://localhost:11434).
OLLAMA_BASE_URL="http://localhost:11434"

# OLLAMA_API_KEY: Optional API key/token for secured or reverse-proxied Ollama instances.
OLLAMA_API_KEY=

# LITELLM_BASE_URL: Base URL for LiteLLM Proxy endpoint (e.g., http://192.168.1.17:4100).
LITELLM_BASE_URL="http://192.168.1.17:4100"

# LITELLM_API_KEY: API key for accessing the LiteLLM Proxy.
LITELLM_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
